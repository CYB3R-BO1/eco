# Copy to .env and adjust for your environment.
# Hostnames below match docker-compose service names. For host-machine dev,
# set POSTGRES_HOST=localhost, REDIS_HOST=localhost, NEO4J_URI=bolt://localhost:7687.

# Environment
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
# CORS_ORIGINS='["http://localhost:3000"]'   # JSON list; empty = disabled

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_ECHO=false

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=platform_neo4j
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=50

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50
# REDIS_PASSWORD=

# Logging
LOG_LEVEL=INFO
LOG_JSON=true
